    {"symbol": "BIMAS", "name": "BIM Mağazalar", "price": 456.78},
    {"symbol": "ASELS", "name": "Aselsan", "price": 345.67},
    {"symbol": "TUPRS", "name": "Tüpraş", "price": 123.45},
    {"symbol": "PETKM", "name": "Petkim", "price": 34.56},
    {"symbol": "EREGL", "name": "Ereğli Demir Çelik", "price": 67.89},
    {"symbol": "SAHOL", "name": "Sabancı Holding", "price": 78.90},
    {"symbol": "KCHOL", "name": "Koç Holding", "price": 156.78},
    {"symbol": "TTKOM", "name": "Türk Telekom", "price": 45.67},
    {"symbol": "PGSUS", "name": "Pegasus", "price": 234.56},
    {"symbol": "MGROS", "name": "Migros", "price": 345.67},
    {"symbol": "SOKM", "name": "Şok Marketler", "price": 234.56},
