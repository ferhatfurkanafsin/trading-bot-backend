    {"symbol": "GARAN", "name": "Garanti Bankası", "price": 89.50},
    {"symbol": "ISCTR", "name": "Türkiye İş Bankası", "price": 12.34},
    {"symbol": "THYAO", "name": "Türk Hava Yolları", "price": 234.50},
