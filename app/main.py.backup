"""
Trading Bot Demo - Backend with Auto-Trading Strategy System
"""

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from sqlalchemy import create_engine, Column, Integer, String, Float, DateTime, Boolean, ForeignKey
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy.orm import sessionmaker
from datetime import datetime
import asyncio
import random
from typing import List
from pydantic import BaseModel

# Database setup
DATABASE_URL = "sqlite:///./trading_demo.db"
engine = create_engine(DATABASE_URL, connect_args={"check_same_thread": False})
SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)
Base = declarative_base()

# Database Models
class Stock(Base):
    __tablename__ = "stocks"
    
    id = Column(Integer, primary_key=True, index=True)
    symbol = Column(String, unique=True, index=True)
    name = Column(String)
    current_price = Column(Float)
    previous_close = Column(Float)
    volume = Column(Integer, default=0)
    last_updated = Column(DateTime, default=datetime.utcnow)

class User(Base):
    __tablename__ = "users"
    
    id = Column(Integer, primary_key=True, index=True)
    username = Column(String, unique=True, index=True)
    balance = Column(Float, default=100000.0)
    created_at = Column(DateTime, default=datetime.utcnow)

class Portfolio(Base):
    __tablename__ = "portfolio"
    
    id = Column(Integer, primary_key=True, index=True)
    user_id = Column(Integer, ForeignKey("users.id"))
    stock_id = Column(Integer, ForeignKey("stocks.id"))
    quantity = Column(Integer)
    avg_buy_price = Column(Float)

class PriceHistory(Base):
    __tablename__ = "price_history"
    
    id = Column(Integer, primary_key=True, index=True)
    stock_id = Column(Integer, ForeignKey("stocks.id"))
    price = Column(Float)
    timestamp = Column(DateTime, default=datetime.utcnow)

class Strategy(Base):
    __tablename__ = "strategies"
    
    id = Column(Integer, primary_key=True, index=True)
    user_id = Column(Integer, ForeignKey("users.id"))
    stock_id = Column(Integer, ForeignKey("stocks.id"))
    strategy_type = Column(String)  # "TAKE_PROFIT", "STOP_LOSS", "BUY_AT_PRICE"
    target_percent = Column(Float, nullable=True)
    target_price = Column(Float, nullable=True)
    quantity = Column(Integer)
    is_active = Column(Boolean, default=True)
    entry_price = Column(Float)  # Price when strategy was created
    created_at = Column(DateTime, default=datetime.utcnow)
    triggered_at = Column(DateTime, nullable=True)

class Trade(Base):
    __tablename__ = "trades"
    
    id = Column(Integer, primary_key=True, index=True)
    user_id = Column(Integer, ForeignKey("users.id"))
    stock_id = Column(Integer, ForeignKey("stocks.id"))
    trade_type = Column(String)  # "BUY" or "SELL"
    quantity = Column(Integer)
    price = Column(Float)
    total_amount = Column(Float)
    is_auto = Column(Boolean, default=False)
    strategy_id = Column(Integer, ForeignKey("strategies.id"), nullable=True)
    created_at = Column(DateTime, default=datetime.utcnow)

# Pydantic Models
class StockResponse(BaseModel):
    id: int
    symbol: str
    name: str
    current_price: float
    previous_close: float
    change_percent: float
    volume: int
    
    class Config:
        from_attributes = True

class PortfolioResponse(BaseModel):
    id: int
    stock_symbol: str
    stock_name: str
    quantity: int
    avg_buy_price: float
    current_price: float
    total_value: float
    profit_loss: float
    profit_loss_percent: float

class StrategyCreate(BaseModel):
    stock_symbol: str
    strategy_type: str
    target_percent: float = None
    target_price: float = None
    quantity: int

class StrategyResponse(BaseModel):
    id: int
    stock_symbol: str
    stock_name: str
    strategy_type: str
    target_percent: float = None
    target_price: float = None
    quantity: int
    is_active: bool
    entry_price: float
    current_price: float
    created_at: str

class TradeResponse(BaseModel):
    id: int
    stock_symbol: str
    trade_type: str
    quantity: int
    price: float
    total_amount: float
    is_auto: bool
    created_at: str

# Create tables
Base.metadata.create_all(bind=engine)

# FastAPI app
app = FastAPI(title="Trading Bot Demo API", version="2.0.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Turkish stock data
